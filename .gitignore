node_modules/
.claude/worktrees-bak
.fleet/worktrees
.research/
.DS_Store
pnpm-store/
# pnpm's content-addressed store when pnpm puts it inside the checkout.
.pnpm-store/
# dsh-playwright-browser's screenshots and page captures. Runtime output.
.dsh-browser/

# Generated by init.sh (M-154): a symlink to gh-wrapper.sh, prepended onto
# the dsh systemd unit's PATH. Not tracked - it's just a link, not content.
.bin/

# dsh-playwright-browser's downloaded Chromium binary (M-154), scoped to
# this checkout via PLAYWRIGHT_BROWSERS_PATH rather than installed
# system-wide - real binary content, not config, never tracked.
.playwright-browsers/

# .dsh/ is dsh's own DSH_HOME, symlinked in from /home/dsh/.dsh and living
# inside this checkout on purpose (M-153) so config edits - ours or dsh's
# own "creator mode" - show up as plain git diffs. These are the known
# state/secret paths within it, confirmed against a real running $DSH_HOME
# (not guessed): session logs, generated artifacts, caches, and credentials/
# keys that must never be committed. Everything else under .dsh/ (AGENTS.md,
# profiles/, .agent-presets/, skills/) stays tracked.
.dsh/sessions/
.dsh/attachments/
.dsh/cache/
.dsh/storages/
# Per-plugin runtime state (dsh-better-git-worktree keeps its session ->
# worktree registry here). Runtime state, never config.
.dsh/plugins/
.dsh/keys/
.dsh/.pnpm-store/
.dsh/profile-node-modules/
.dsh/profiles/*/node_modules/
# Profile-level node_modules straight under profiles/ (the rule above only
# matches one directory deep, e.g. profiles/web/node_modules).
.dsh/profiles/node_modules/
# The profile's pnpm lockfile: generated by the profile's own install, never
# tracked (the root pnpm-lock.yaml is the tracked one).
.dsh/profiles/*/pnpm-lock.yaml
# dsh plugin-manager's per-profile runtime logs. Runtime output, not config.
.dsh/profiles/*/.plugin-manager/
.dsh/.credentials.yaml
.dsh/.gh-installation-token
.dsh/.anonymous-user-id
# Auto-generated composition scaffolding dsh writes on first boot per
# profile ("edit cordis.patch.yml, not this file" per its own header) -
# derived from package.json's bundles + cordis.patch.yml, not meant to be
# hand-edited or tracked.
.dsh/profiles/*/cordis.yml

# Watchdog act/log mode override - written by the UI settings row,
# read by loop-watchdog on every check. Runtime state, not config.
.dsh/profiles/*/watchdog-mode.json

# Working checkout of github.com/chrisjohnson/dsh-plugins (plugin source lives there,
# not here). Dev-time clone only - this repo consumes the plugins as pinned npm/git
# packages installed into .dsh/profiles/web. See AGENTS.md "Plugins live elsewhere".
.plugin-dev/

# Written by DSH at boot: its record of which plugins passed the peer-range
# admission check. Derived state, regenerated every boot.
.dsh/profiles/*/compatibility.json
# DSH renames settings.yaml to this after auto-importing it into
# cordis.patch.yml. Settings are migrated by hand, so it should never appear;
# if it does, it is a stale copy, not config.
.dsh/settings.yaml.imported

# Disposable lab state: copies of DSH_HOME used to rehearse upgrades, and what
# scripts/lab.sh keeps per lab (pid, log, access URL, smoke results).
.lab/

# DSH's startup diagnostics, written when a boot fails.
.dsh/logs/

# DSH config editor lock file, created next to cordis.patch.yml writes.
.x.lock
