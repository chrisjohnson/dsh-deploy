node_modules/
.claude/worktrees-bak
.fleet/worktrees
.research/
.DS_Store
pnpm-store/

# Generated by init.sh (M-154): a symlink to gh-wrapper.sh, prepended onto
# the dsh systemd unit's PATH. Not tracked - it's just a link, not content.
.bin/

# dsh-playwright-browser's downloaded Chromium binary (M-154), scoped to
# this checkout via PLAYWRIGHT_BROWSERS_PATH rather than installed
# system-wide - real binary content, not config, never tracked.
.playwright-browsers/

# .dsh/ is dsh's own DSH_HOME, symlinked in from /home/dsh/.dsh and living
# inside this checkout on purpose (M-153) so config edits - ours or dsh's
# own "creator mode" - show up as plain git diffs. These are the known
# state/secret paths within it, confirmed against a real running $DSH_HOME
# (not guessed): session logs, generated artifacts, caches, and credentials/
# keys that must never be committed. Everything else under .dsh/ (settings.yaml,
# AGENTS.md, profiles/, .agent-presets/, skills/) stays tracked.
.dsh/sessions/
.dsh/attachments/
.dsh/cache/
.dsh/storages/
.dsh/keys/
.dsh/.pnpm-store/
.dsh/profile-node-modules/
.dsh/profiles/*/node_modules/
.dsh/.credentials.yaml
.dsh/.gh-installation-token
.dsh/.anonymous-user-id
# Auto-generated composition scaffolding dsh writes on first boot per
# profile ("edit cordis.patch.yml, not this file" per its own header) -
# derived from package.json's bundles + cordis.patch.yml, not meant to be
# hand-edited or tracked.
.dsh/profiles/*/cordis.yml
