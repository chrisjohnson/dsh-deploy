+  finalized: 'sidebar.finalized',
+  discarded: 'sidebar.discarded',
+}
+
+/**
+ * Register both shipped dictionaries (untyped single-locale form, so the call
+ * typechecks in the plugin's standalone graph where the full namespace merge
+ * is absent). Call from a Client fiber where the locale service is installed;
+ * returns an idempotent disposer.
+ */
+export function registerWorktreeLocale(locale: LocaleRuntime): () => void {
+  const disposers = [
+    locale.register('worktree', 'zh', worktreeZh),
