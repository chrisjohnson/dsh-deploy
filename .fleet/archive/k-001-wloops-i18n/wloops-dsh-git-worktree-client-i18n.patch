new file mode 100644
index 0000000..0c705c9
--- /dev/null
+++ b/src/client/locales/worktree-locale.d.ts
@@ -0,0 +1,12 @@
+/**
+ * Claim the plugin-owned "worktree" namespace in the shared locale
+ * namespace map (dsh-client-ui-slots) so the locale framework's typed
+ * seats check against this plugin's key set wherever the full dsh type
+ * graph is present. This ambient declaration is a no-op in the plugin's
+ * standalone typecheck, where the module is not installed.
+ */
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    worktree: import('./worktree.js').WorktreeLocaleKey
+  }
+}
