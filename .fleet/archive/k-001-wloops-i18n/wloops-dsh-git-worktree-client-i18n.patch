--- /dev/null
+++ b/tests/support/zh-translate.ts
@@ -0,0 +1,21 @@
+import { worktreeZh, type WorktreeLocaleKey, type WorktreeTranslate } from '../../src/client/locales/worktree.js'
+
+/**
+ * Test translate resolving keys against the shipped zh dictionary (with
+ * {placeholder} interpolation). Existing assertions on the exact Chinese copy
+ * keep verifying the same rendered strings.
+ */
+export function createZhTranslate(): WorktreeTranslate {
+  return (key: WorktreeLocaleKey, params?: Record<string, unknown>) => {
+    let out = worktreeZh[key]
+    if (params) {
+      for (const [name, value] of Object.entries(params)) {
+        out = out.split(`{${name}}`).join(String(value))
+      }
+    }
+    return out
+  }
+}
+
+/** Shared instance for fixture wiring. */
+export const zhT: WorktreeTranslate = createZhTranslate()
