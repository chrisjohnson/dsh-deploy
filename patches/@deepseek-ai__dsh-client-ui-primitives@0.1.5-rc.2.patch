diff --git a/lib/index.js b/lib/index.js
index 6bb1a8aa9d09220f22a86f4df89279704f0c725e..b150d35d1b68234fb8664e1f640c66f215179cd2 100644
--- a/lib/index.js
+++ b/lib/index.js
@@ -7083,6 +7083,19 @@ function remoteImageUrl(url) {
 		const protocol = new URL(url).protocol;
 		return protocol === "http:" || protocol === "https:" ? url : void 0;
 	} catch {
+		// Same-origin relative URLs (e.g. a plugin's own image-serving route
+		// like /dsh-image-gen/image?id=...) fail bare URL parsing (no
+		// protocol/host) but are valid, loadable <img src> values in a
+		// browser. Resolve against the page origin only to classify the
+		// URL as acceptable; return the ORIGINAL relative string so the
+		// browser resolves it exactly as authored (correct through any
+		// reverse proxy / path prefix), not the resolved absolute one.
+		try {
+			if (typeof window !== "undefined" && window.location && url.startsWith("/")) {
+				const resolved = new URL(url, window.location.origin);
+				if (resolved.protocol === "http:" || resolved.protocol === "https:") return url;
+			}
+		} catch {}
 		return;
 	}
 }
